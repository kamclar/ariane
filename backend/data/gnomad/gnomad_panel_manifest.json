      },
      "automatic_release_activation": false,
      "release_change_requires": [
        "rule-set compatibility review",
        "source identity review",
        "regression test approval"
      ],
      "known_limitations": [
        "ENIGMA v1.2 does not define the width of the coverage region surrounding a variant; ARIANE uses the genomic REF span and records that scope.",
        "The public GRCh38 genome coverage product is gnomAD r3.0.1 while the frequency callset is v3.1.2; exact sample compatibility is not asserted.",
        "ENIGMA v1.2 does not publish an exhaustive machine-readable catalog of well-established pathogenic founder variants; the local catalog is provenance-bearing but curated and non-exhaustive."
      ],
      "frequency_criteria": {
        "source": "ClinGen ENIGMA BRCA1/2 VCEP v1.2 Appendix G",
        "source_url": "https://cspec.genome.network/cspec/File/id/5a75d1a0-1222-46a2-8802-68a4f2251a3a/data",
        "metric": "faf95",
        "subset": "non_cancer",
        "dataset_combination": "assess_exome_and_genome_separately_then_use_highest_qualifying_faf95",
        "required_dataset_runtime_keys": ["v2_1_non_cancer", "v3_1_non_cancer"],
        "scored_non_founder_ancestries": ["afr", "amr", "eas", "nfe", "sas"],
        "scoring_rule": "Use the highest non-cancer FAF95 among ENIGMA non-founder populations, assessing exome and genome data separately.",
        "outbred_observation_count": {
          "single_observation": "not_informative",
          "minimum_observations_for_ba1_bs1": 2,
          "pm2_requires_zero_observations": true
        },
        "ba1": {
          "operator": ">",
          "threshold": 0.001,
          "strength": "Stand-alone",
          "points": -99,
          "minimum_mean_depth": 20.0,
          "requires_pass_record": true,
          "exclude_well_established_pathogenic_founder_variants": true
        },
        "bs1": {
          "minimum_mean_depth": 20.0,
          "requires_pass_record": true,
          "exclude_well_established_pathogenic_founder_variants": true,
          "strong": {"operator": ">", "threshold": 0.0001, "strength": "Strong", "points": -4},
          "supporting": {"lower_operator": ">", "lower_threshold": 0.00002, "upper_operator": "<=", "upper_threshold": 0.0001, "strength": "Supporting", "points": -1}
        },
        "pm2": {
          "strength": "Supporting",
          "points": 1,
          "required_absence_dataset_runtime_keys": ["v2_1_non_cancer", "v3_1_non_cancer"],
          "minimum_mean_depth": 25.0,
          "absence_scope": "scored_non_founder_ancestries",
          "single_outbred_observation": "not_informative",
          "excluded_variant_types": ["frameshift", "inframe_deletion", "inframe_insertion", "inframe_delins", "exon_deletion", "exon_duplication", "deletion", "insertion", "delins", "duplication"],
          "coverage_scope": "variant_reference_span",
          "coverage_scope_note": "ENIGMA v1.2 requires average read depth in the region surrounding the variant but does not define a flank width. ARIANE averages every genomic position represented by REF and does not invent a flanking window."
        },
        "pathogenic_founder_exception": {
          "rule": "Do not apply BA1 or BS1 to well-established pathogenic founder variants.",
          "snapshot": "backend/data/brca_pathogenic_founder_variants.json",
          "catalog_completeness": "curated_not_exhaustive"
        }
      }
    }
  },
